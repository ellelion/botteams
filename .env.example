# Names only. Never commit a value from this file.
# Local values go in .env.local, which .gitignore covers.

# Stripe, Ellelion LLC (acct_1TngflCZ0S1wfaJh).
# Test keys locally, live keys on the production environment only. The
# price IDs differ between the two modes, so all four move together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# [Grok Bot Teams] Side rail, one-time USD.
# lookup_key grokbotteams_side_rail_1m / _3m / _6m
STRIPE_PRICE_RAIL_1M=
STRIPE_PRICE_RAIL_3M=
STRIPE_PRICE_RAIL_6M=

# Ellelion Neon (same account as agentpluginsdirectory.com / launchelion).
# Tables are prefixed grokbotteams_. Do not point this at a new vendor.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel AI Gateway. OIDC is enough on Vercel. Locally you can set a key
# or pull VERCEL_OIDC_TOKEN. Do not set OPENAI_API_KEY.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Optional. Without these the webhook only writes a server log, which is
# enough to work from alongside the Stripe Dashboard.
RESEND_API_KEY=
SPONSOR_NOTIFY_FROM=

# Optional. Skillselion Fly listings (otherwise the proxy uses skillselion.com/api/upstream).
SKILLSELION_API_SECRET=

# OpenPanel (org prism-3534, project botteams). Client id is public; still
# keep the value out of this file. Local: .env.local. Hosted: Vercel env.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Search verification (public meta tokens). Optional locally.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

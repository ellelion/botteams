# Names only. Never commit a value from this file.
# Local values go in .env.local, which .gitignore covers.

# Stripe, Ellelion LLC (acct_1TngflCZ0S1wfaJh).
# Test keys locally, live keys on the production environment only. The
# price IDs differ between the two modes, so all four move together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# [Grok Bot Teams] Side rail, one-time USD.
# lookup_key grokbotteams_side_rail_1m / _3m / _6m
STRIPE_PRICE_RAIL_1M=
STRIPE_PRICE_RAIL_3M=
STRIPE_PRICE_RAIL_6M=

# Optional. Without these the webhook only writes a server log, which is
# enough to work from alongside the Stripe Dashboard.
RESEND_API_KEY=
SPONSOR_NOTIFY_FROM=

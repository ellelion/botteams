# Names only. Never commit a value from this file.
# Local values go in .env.local, which .gitignore covers.

# Stripe, Ellelion LLC.
# Test keys locally, live keys on the production environment only. The
# price IDs differ between the two modes, so all four move together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# [Grok Bot Teams] Side rail, one-time USD.
# lookup_key grokbotteams_side_rail_1m / _3m / _6m
STRIPE_PRICE_RAIL_1M=
STRIPE_PRICE_RAIL_3M=
STRIPE_PRICE_RAIL_6M=

# Ellelion database. Tables are prefixed grokbotteams_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel AI Gateway. OIDC is enough on Vercel. Locally you can set a key
# or pull VERCEL_OIDC_TOKEN. Do not set OPENAI_API_KEY.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Optional. Without these the webhook only writes a server log, which is
# enough to work from alongside the Stripe Dashboard.
RESEND_API_KEY=
SPONSOR_NOTIFY_FROM=

# Optional. Skillselion Fly listings (otherwise the proxy uses skillselion.com/api/upstream).
SKILLSELION_API_SECRET=

# OpenPanel. The client id is public, but keep environment values out of this
# file. Local: .env.local. Hosted: Vercel env.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Search verification (public meta tokens). Optional locally.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# X mention worker. Create the App under the @Botteams_ai brand account.
# Read uses the app Bearer Token. Replies use the non-expiring OAuth 1.0a
# user tokens for @Botteams_ai. X charges for API reads and replies.
X_API_BEARER_TOKEN=
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_USER_ID=
X_HANDLE=Botteams_ai
# Maximum direct-link replies per UTC day. Later replies use the profile-link
# fallback without a URL, which keeps X write costs bounded.
X_DAILY_URL_REPLY_CAP=20
# Maximum total X replies per UTC day. Later completed submissions are listed
# normally but receive no automated X reply.
X_DAILY_REPLY_CAP=100

# Preferred: a GitHub App installed only on ellelion/botteams. Grant Contents,
# Pull requests, and Issues write access. Store the downloaded PEM as base64.
BOTTEAMS_GITHUB_APP_ID=
BOTTEAMS_GITHUB_INSTALLATION_ID=
BOTTEAMS_GITHUB_PRIVATE_KEY_BASE64=
# Fallback for local development only. Never use a personal token in production.
BOTTEAMS_GITHUB_TOKEN=
BOTTEAMS_GITHUB_REPOSITORY=ellelion/botteams
BOTTEAMS_GITHUB_BASE_BRANCH=main

# Vercel sends this as Authorization: Bearer <value> to cron routes.
CRON_SECRET=

# Safe default: the first run records the newest mention and skips older
# ones. Set true for one deployment only when an intentional backfill is
# wanted, then remove it.
X_MENTION_BACKFILL=false
